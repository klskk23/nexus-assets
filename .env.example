# Nexus Assets 配置样例
#
#   cp .env.example .env && chmod 600 .env
#
# 真实环境变量优先于本文件，所以容器、CI 或一次性的
# `NEXUS_ADDR=:9000 ./nexus` 都能覆盖这里的值而不必改文件。

# ── 必填 ─────────────────────────────────────────────

# JWT 签名密钥。缺失时程序拒绝启动 —— 自动生成的密钥每次重启都会变，
# 会让所有人静默掉线，且很难查出原因。生产环境请用随机长字符串：
#   openssl rand -base64 48
NEXUS_JWT_SECRET=dev-only-change-me

# 允许登录的企业邮箱域名，逗号分隔。本版不做权限区分，
# 这份白名单就是唯一的准入边界。
NEXUS_ALLOWED_EMAIL_DOMAINS=example.com

# ── 可选 ─────────────────────────────────────────────

# 数据库文件路径（默认 ./nexus.db）
NEXUS_DB_PATH=./nexus.db

# 监听地址（默认 :8080）
NEXUS_ADDR=:8080

# 访问令牌有效期（默认 15m）。它短是因为可以续期：浏览器另外拿着一个
# 只进 HttpOnly Cookie 的刷新令牌，过期前会自动换一张新的访问令牌。
NEXUS_JWT_TTL=15m

# 刷新令牌有效期（默认 720h，即 30 天）：离开这么久才需要重新登录。
# 必须大于 NEXUS_JWT_TTL，否则会话在能续期之前就结束了。
# 每次续期都会轮换：旧令牌当场作废，被重放就吊销整条会话链。
NEXUS_REFRESH_TTL=720h

# ── 首次启动的初始管理员 ──────────────────────────────
#
# 系统以空库启动，不预置任何示例数据。库中没有任何账号时，
# 用下面两项创建第一个本地管理员；之后这两项会被忽略。

NEXUS_ADMIN_EMAIL=admin@example.com
NEXUS_ADMIN_PASSWORD=correct-horse

# 一把长期有效的管理员密钥，用于脚本、监控这类"没人替它续期"的调用方：
#
#   curl -H "Authorization: Bearer $NEXUS_ADMIN_API_KEY" http://主机:8080/api/rows?category_id=…
#
# 它以 NEXUS_ADMIN_EMAIL 这个账号的身份行事（两者必须一起配），
# 因此审计里记的是那个人。它**永不过期、也不能在界面上撤销** ——
# 要作废就是从这里删掉再重启。正因如此，至少 32 位，用随机串：
#   openssl rand -base64 36
# 界面上的「API 密钥」列表会把它列出来（标注"配置文件"），但没有撤销按钮。
# NEXUS_ADMIN_API_KEY=

# ── 标签打印（可选）───────────────────────────────────
#
# 指向 zenith-printer。不配置时，界面上不会出现任何与打印有关的东西 ——
# 没有打印机的安装本来就该长这样。
# 配上之后，类别设置里的"打印预设"会变成一个下拉框，直接列出对面有哪些预设。
# ZENITH_PRINTER_SERVICE_URL=http://127.0.0.1:3000

# ── Google 登录（可选，不配则只能用本地账号）──────────

# NEXUS_OIDC_CLIENT_ID=
# NEXUS_OIDC_CLIENT_SECRET=
# NEXUS_OIDC_REDIRECT_URL=http://localhost:8080/api/auth/oidc/callback

# 默认 true：比对 Google Workspace 的 hd 声明，比只看邮箱后缀更强。
# 公司若未使用 Workspace，hd 声明不存在，需置为 false 退回后缀比对。
# NEXUS_OIDC_REQUIRE_HD=true
